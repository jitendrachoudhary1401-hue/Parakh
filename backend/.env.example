# ============================================================
# Project PARAKH — Environment Variables (Self-Hosted / Sovereign Stack)
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real credentials to version control.
# ============================================================

# --- Application ---
APP_NAME=PARAKH
APP_ENV=development
# Options: development, staging, production
DEBUG=true
LOG_LEVEL=INFO

# --- Server ---
HOST=0.0.0.0
PORT=8000
WORKERS=4

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://parakh_user:your_password_here@localhost:5432/parakh_db
# Synchronous URL for Alembic migrations
DATABASE_URL_SYNC=postgresql://parakh_user:your_password_here@localhost:5432/parakh_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# --- MongoDB ---
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=parakh_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- API Key Authentication ---
API_KEY=parakh_sec_api_key_2026

# --- JWT / Authentication ---
# Generate a strong random secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google Cloud Vision (OCR) ---
GOOGLE_CLOUD_VISION_KEY=your_google_cloud_vision_api_key_here
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- GS1 India API ---
GS1_API_URL=https://api.gs1india.org/v1
GS1_API_KEY=your_gs1_api_key_here

# --- Object Storage (Self-Hosted MinIO or Local Filesystem) ---
STORAGE_PROVIDER=minio
# Options: minio, local

# MinIO / Open S3 Configuration
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_BUCKET=parakh-storage
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_PRESIGNED_URL_EXPIRY_SECONDS=3600

# Local Filesystem Storage (if STORAGE_PROVIDER=local)
LOCAL_STORAGE_PATH=D:\Devanshi\Project 17(Parakh)\Data

# --- Hyperledger Fabric (Blockchain) ---
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_ENDPOINT=grpc://localhost:7051
BLOCKCHAIN_NETWORK=parakh-network
BLOCKCHAIN_CHANNEL=evidence-channel
BLOCKCHAIN_CHAINCODE=parakh-evidence
BLOCKCHAIN_MSP_ID=Org1MSP
BLOCKCHAIN_CERT_PATH=/path/to/cert.pem
BLOCKCHAIN_KEY_PATH=/path/to/key.pem

# --- WhatsApp Business API ---
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here

# --- CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Rate Limiting ---
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_ANALYSIS=10/minute
RATE_LIMIT_EVIDENCE=10/minute
RATE_LIMIT_CITIZEN_REPORT=5/minute
RATE_LIMIT_DEFAULT=60/minute

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=25
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
MIN_IMAGE_RESOLUTION=640

# --- AI / ML ---
NER_MODEL_NAME=dslim/bert-base-NER
VIT_MODEL_NAME=google/vit-base-patch16-224
NER_CONFIDENCE_THRESHOLD=0.5
ANOMALY_DETECTION_ENABLED=true

# --- Encryption ---
ENCRYPTION_KEY=CHANGE_ME_TO_A_32_BYTE_BASE64_KEY

# --- Audit ---
AUDIT_LOG_ENABLED=true
